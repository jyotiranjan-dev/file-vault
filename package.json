{
  "name": "vaultdrop",
  "version": "1.0.0",
  "private": true,
  "description": "Private, encrypted, self-hosted file vault. Zero dependencies.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test.js",
    "backup": "node --disable-warning=ExperimentalWarning server.js backup ./backups"
  }
}